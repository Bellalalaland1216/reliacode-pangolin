<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('partials/boot-head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#ffffff">
  <title>ClawMaster / 业务 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css?v=20260901c">
  <link rel="stylesheet" href="/css/clawmaster.css?v=20260903a">
</head>
<body>
  <%- include('partials/boot-loader') %>
  <%- include('partials/nav', { active: 'business' }) %>

  <div class="container">
    <div class="page-header">
      <h1>业务</h1>
    </div>

    <div class="section-title">业务功能</div>
    <div class="app-grid">
      <a href="/factory" class="app-tile"><span class="app-icon orange"><%- icon('box') %></span><span class="app-label">工厂装箱</span></a>
      <a href="/warehouse" class="app-tile"><span class="app-icon green"><%- icon('truck') %></span><span class="app-label">品牌发货</span></a>
      <a href="/generate" class="app-tile"><span class="app-icon purple"><%- icon('tag') %></span><span class="app-label">产品与码</span></a>
      <a href="/codes" class="app-tile"><span class="app-icon indigo"><%- icon('search') %></span><span class="app-label">码查询</span></a>
      <a href="/downloads" class="app-tile"><span class="app-icon teal"><%- icon('download') %></span><span class="app-label">生产码包</span></a>
      <a href="/distributors" class="app-tile"><span class="app-icon blue"><%- icon('handshake') %></span><span class="app-label">代理商</span></a>
    </div>
  </div>
</body>
</html>
