<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#f3f5f1">
  <title>穿山甲溯源大师 · 企业登录</title>
  <link rel="icon" href="/icons/pangolin-photo.png?v=20260905">
  <style nonce="<%= cspNonce %>">
    :root {
      --page: #f3f5f1;
      --sage: #e9f0e9;
      --ink: #17251c;
      --muted: #53645a;
      --brand: #205b42;
      --brand-strong: #174832;
      --line: #7f8f84;
      --danger: #a52a20;
    }
    * { box-sizing: border-box; }
    html { background: var(--page); }
    body {
      margin: 0;
      min-width: 320px;
      min-height: 100vh;
      background: var(--page);
      color: var(--ink);
      font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 16px;
      line-height: 1.5;
    }
    button, input { font: inherit; }
    button, a, input, label { -webkit-tap-highlight-color: transparent; }
    a { color: inherit; }
    .login-page {
      position: relative;
      isolation: isolate;
      display: flex;
      min-height: 100vh;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 48px 20px;
    }
    .login-page::before,
    .login-page::after {
      position: fixed;
      z-index: -1;
      border-radius: 50%;
      content: "";
      filter: blur(2px);
      pointer-events: none;
    }
    .login-page::before {
      top: -18vw;
      left: -10vw;
      width: min(48vw, 680px);
      aspect-ratio: 1;
      background: rgba(213, 226, 215, .74);
      box-shadow: 22vw 16vw 0 rgba(233, 240, 233, .72);
    }
    .login-page::after {
      right: -13vw;
      bottom: -24vw;
      width: min(52vw, 760px);
      aspect-ratio: 1;
      background: rgba(225, 235, 226, .84);
      box-shadow: -24vw -7vw 0 rgba(245, 248, 244, .9);
    }
    .page-frame {
      display: grid;
      width: min(100%, 480px);
      gap: 14px;
    }
    .consumer-entry {
      position: relative;
      display: inline-flex;
      width: 100%;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 16px;
      border: 1px solid rgba(255, 255, 255, .78);
      border-radius: 14px;
      background: rgba(255, 255, 255, .48);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .72), 0 8px 24px rgba(23, 37, 28, .04);
      color: var(--brand);
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      text-underline-offset: 4px;
      backdrop-filter: blur(18px) saturate(132%);
      -webkit-backdrop-filter: blur(18px) saturate(132%);
      transition: background-color .16s ease, border-color .16s ease, transform .16s ease;
    }
    .consumer-entry:hover { border-color: rgba(255, 255, 255, .96); background: rgba(255, 255, 255, .7); }
    .consumer-entry:active { transform: translateY(1px); }
    .consumer-entry .ui-icon { width: 18px; height: 18px; }
    .login-shell {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, .82);
      border-radius: 28px;
      background: rgba(255, 255, 255, .64);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .92), inset 0 -1px 0 rgba(127, 143, 132, .08), 0 30px 72px rgba(23, 37, 28, .11);
      backdrop-filter: blur(30px) saturate(138%);
      -webkit-backdrop-filter: blur(30px) saturate(138%);
    }
    .login-shell::before {
      position: absolute;
      top: -120px;
      left: 50%;
      width: 360px;
      height: 200px;
      border-radius: 50%;
      background: rgba(255, 255, 255, .58);
      content: "";
      filter: blur(34px);
      pointer-events: none;
      transform: translateX(-50%);
    }
    .brand-mark {
      position: relative;
      display: grid;
      width: 78px;
      height: 78px;
      place-items: center;
      margin: 0 auto 20px;
      border: 1px solid rgba(255, 255, 255, .9);
      border-radius: 24px;
      background: linear-gradient(145deg, rgba(255, 255, 255, .82), rgba(233, 240, 233, .56));
      box-shadow: inset 2px 2px 2px rgba(255, 255, 255, .9), inset -2px -3px 8px rgba(32, 91, 66, .08), 0 14px 30px rgba(32, 91, 66, .12);
    }
    .brand-mark::after {
      position: absolute;
      inset: 6px 10px auto;
      height: 16px;
      border-radius: 50%;
      background: rgba(255, 255, 255, .62);
      content: "";
      filter: blur(5px);
      pointer-events: none;
    }
    .brand-mark img { position: relative; z-index: 1; display: block; width: 54px; height: 54px; border-radius: 16px; object-fit: cover; box-shadow: 0 2px 8px rgba(23, 37, 28, .12); }
    .form-panel {
      position: relative;
      z-index: 1;
      padding: 42px 40px 40px;
    }
    .form-content { width: 100%; }
    .form-content h1 { margin: 0; font-size: 28px; font-weight: 600; letter-spacing: -.015em; line-height: 38px; text-align: center; }
    .login-status { min-height: 22px; margin: 16px 0 0; color: var(--danger); font-size: 14px; font-weight: 500; line-height: 22px; text-align: center; }
    .login-status:empty::before { content: "\00a0"; }
    .field-group { margin-top: 14px; }
    .field-label { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; line-height: 22px; }
    .input-wrap { position: relative; }
    .text-input {
      display: block;
      width: 100%;
      height: 48px;
      padding: 10px 14px;
      border: 1px solid rgba(127, 143, 132, .88);
      border-radius: 12px;
      outline: none;
      background: rgba(255, 255, 255, .74);
      color: var(--ink);
      font-size: 16px;
      line-height: 24px;
      transition: border-color .16s ease, box-shadow .16s ease, background-color .16s ease;
    }
    .text-input::placeholder { color: #637469; opacity: 1; }
    .text-input:hover { border-color: var(--muted); background: rgba(255, 255, 255, .88); }
    .text-input:focus { border-color: var(--brand); background: rgba(255, 255, 255, .94); box-shadow: 0 0 0 3px rgba(32, 91, 66, .18); }
    .text-input[aria-invalid="true"] { border-color: var(--danger); }
    .text-input[aria-invalid="true"]:focus { box-shadow: 0 0 0 3px rgba(165, 42, 32, .16); }
    .password-input { padding-right: 84px; }
    .password-toggle {
      position: absolute;
      top: 2px;
      right: 2px;
      display: inline-flex;
      min-width: 72px;
      height: 44px;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0 10px;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: var(--brand);
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
    }
    .password-toggle:hover { background: rgba(233, 240, 233, .82); }
    .password-toggle svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
    .field-note { min-height: 0; margin: 0; color: var(--muted); font-size: 13px; line-height: 22px; }
    .field-note:empty { display: none; }
    .field-note.is-error { display: block; margin-top: 4px; color: var(--danger); font-weight: 500; }
    .remember-block { margin: 14px 0 18px; }
    .remember-label { display: inline-flex; min-height: 44px; align-items: center; gap: 10px; color: #33483b; cursor: pointer; font-size: 14px; }
    .remember-label input { width: 20px; height: 20px; margin: 0; accent-color: var(--brand); }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    .login-button {
      display: inline-flex;
      width: 100%;
      height: 48px;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 0 18px;
      border: 1px solid var(--brand);
      border-radius: 12px;
      background: var(--brand);
      color: #fff;
      cursor: pointer;
      font-size: 16px;
      font-weight: 600;
      line-height: 24px;
      box-shadow: 0 10px 22px rgba(32, 91, 66, .18);
      transition: background-color .16s ease, border-color .16s ease, box-shadow .16s ease, transform .16s ease;
    }
    .login-button:hover { border-color: var(--brand-strong); background: var(--brand-strong); box-shadow: 0 12px 26px rgba(32, 91, 66, .24); }
    .login-button:active { background: #123a29; transform: translateY(1px); }
    .login-button:disabled { border-color: #6d8b79; background: #6d8b79; cursor: wait; }
    .button-spinner { display: none; width: 16px; height: 16px; border: 2px solid rgba(255, 255, 255, .48); border-top-color: #fff; border-radius: 50%; animation: spin .75s linear infinite; }
    .login-button.is-loading .button-spinner { display: inline-block; }
    .form-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 18px; }
    .secondary-link,
    .help-link { display: inline-flex; min-height: 44px; align-items: center; gap: 7px; color: var(--brand); font-size: 14px; font-weight: 600; text-decoration: none; text-underline-offset: 4px; }
    .secondary-link:hover { text-decoration: underline; }
    .secondary-link .ui-icon { width: 17px; height: 17px; }
    .help-link:hover { text-decoration: underline; }
    .help-link.is-static { color: var(--muted); cursor: default; }
    .help-link.is-static:hover { text-decoration: none; }
    .ui-icon { display: inline-block; width: 1.1em; height: 1.1em; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
    :focus-visible { outline: 3px solid rgba(32, 91, 66, .42); outline-offset: 3px; }
    .text-input:focus-visible { outline: 0; }
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus { -webkit-text-fill-color: var(--ink); box-shadow: 0 0 0 1000px #fff inset; caret-color: var(--ink); }
    @keyframes spin { to { transform: rotate(360deg); } }
    @media (max-width: 600px) {
      .login-page { align-items: flex-start; overflow: visible; padding: 28px 20px; }
      .login-shell { border-radius: 24px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .9), 0 20px 48px rgba(23, 37, 28, .09); }
      .form-panel { padding: 32px 24px 28px; }
      .brand-mark { width: 70px; height: 70px; margin-bottom: 16px; border-radius: 22px; }
      .brand-mark img { width: 50px; height: 50px; border-radius: 15px; }
      .form-content h1 { font-size: 26px; line-height: 36px; }
      .field-group { margin-top: 14px; }
      .form-actions { align-items: flex-start; flex-direction: column; gap: 0; }
    }
    @media (max-width: 360px) {
      .login-page { padding: 16px; }
      .form-panel { padding-right: 20px; padding-left: 20px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
    }
  </style>
</head>
<body>
  <main class="login-page">
    <div class="page-frame">
      <section class="login-shell" aria-labelledby="loginTitle">
        <section class="form-panel">
          <div class="form-content">
            <div class="brand-mark"><img src="/icons/pangolin-photo.png?v=20260915" alt="穿山甲溯源大师" width="48" height="48"></div>
            <h1 id="loginTitle">登录企业工作台</h1>
            <div id="loginStatus" class="login-status" role="alert" aria-live="assertive"><%= error || '' %></div>
            <form id="loginForm" method="POST" action="/login" autocomplete="on" novalidate>
              <div class="field-group">
                <label class="field-label" for="loginUsername">账号</label>
                <div class="input-wrap"><input class="text-input" id="loginUsername" type="text" name="username" value="<%= username || '' %>" autocomplete="username" autocapitalize="none" spellcheck="false" aria-describedby="usernameNote" required></div>
                <p class="field-note" id="usernameNote"></p>
              </div>
              <div class="field-group">
                <label class="field-label" for="loginPassword">密码</label>
                <div class="input-wrap">
                  <input class="text-input password-input" id="loginPassword" type="password" name="password" autocomplete="current-password" aria-describedby="passwordNote" required>
                  <button class="password-toggle" id="passwordToggle" type="button" aria-controls="loginPassword" aria-pressed="false" aria-label="显示密码">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.7"></circle></svg><span>显示</span>
                  </button>
                </div>
                <p class="field-note" id="passwordNote"></p>
              </div>
              <div class="remember-block">
                <label class="remember-label" for="rememberLogin"><input id="rememberLogin" type="checkbox" name="remember" value="1" autocomplete="on" aria-describedby="sessionNote"><span>在此设备保持登录</span></label>
                <span class="sr-only" id="sessionNote">选择后保持 30 天；未选择时最长 12 小时</span>
              </div>
              <button class="login-button" id="loginButton" type="submit"><span class="button-spinner" aria-hidden="true"></span><span id="loginButtonText">登录</span></button>
            </form>
            <div class="form-actions">
              <a class="secondary-link" href="/register?mode=partner"><span>邀请码注册</span><%- icon('arrow-right') %></a>
              <% if (supportPhone && supportPhoneHref) { %>
                <a class="help-link" href="tel:<%= supportPhoneHref %>" aria-label="登录帮助，联系平台管理员 <%= supportPhone %>">登录帮助</a>
              <% } else { %>
                <span class="help-link is-static" title="请联系为你分配账号的平台管理员重置密码">登录帮助：联系管理员</span>
              <% } %>
            </div>
          </div>
        </section>
      </section>
      <a class="consumer-entry" href="/v"><span>商品溯源查询 · 无需登录</span><%- icon('arrow-right') %></a>
    </div>
  </main>
  <script nonce="<%= cspNonce %>">
    (() => {
      const form = document.getElementById('loginForm');
      const username = document.getElementById('loginUsername');
      const password = document.getElementById('loginPassword');
      const usernameNote = document.getElementById('usernameNote');
      const passwordNote = document.getElementById('passwordNote');
      const status = document.getElementById('loginStatus');
      const submitButton = document.getElementById('loginButton');
      const submitText = document.getElementById('loginButtonText');
      const passwordToggle = document.getElementById('passwordToggle');
      const passwordToggleText = passwordToggle.querySelector('span');
      let navigating = false;
      function setFieldError(input, note, message, defaultMessage) {
        const hasError = Boolean(message);
        input.setAttribute('aria-invalid', String(hasError));
        note.textContent = message || defaultMessage || '';
        note.classList.toggle('is-error', hasError);
      }
      function setLoading(loading) {
        submitButton.disabled = loading;
        submitButton.classList.toggle('is-loading', loading);
        submitButton.setAttribute('aria-busy', String(loading));
        submitText.textContent = loading ? '正在登录…' : '登录';
      }
      function clearStatus() {
        status.textContent = '';
        setFieldError(username, usernameNote, '', '');
        setFieldError(password, passwordNote, '', '');
      }
      passwordToggle.addEventListener('pointerdown', event => {
        if (document.activeElement === password) event.preventDefault();
      });
      passwordToggle.addEventListener('click', () => {
        const wasFocused = document.activeElement === password;
        const start = password.selectionStart;
        const end = password.selectionEnd;
        const showing = password.type === 'text';
        password.type = showing ? 'password' : 'text';
        passwordToggle.setAttribute('aria-pressed', String(!showing));
        passwordToggle.setAttribute('aria-label', showing ? '显示密码' : '隐藏密码');
        passwordToggleText.textContent = showing ? '显示' : '隐藏';
        if (wasFocused) {
          password.focus({ preventScroll: true });
          if (start !== null && end !== null) password.setSelectionRange(start, end);
        }
      });
      username.addEventListener('input', () => setFieldError(username, usernameNote, '', ''));
      password.addEventListener('input', () => setFieldError(password, passwordNote, '', ''));
      form.addEventListener('submit', async event => {
        if (!window.fetch) return;
        event.preventDefault();
        if (submitButton.disabled) return;
        clearStatus();
        const trimmedUsername = username.value.trim();
        let firstInvalid = null;
        if (!trimmedUsername) { setFieldError(username, usernameNote, '请输入账号', ''); firstInvalid = username; }
        if (!password.value) { setFieldError(password, passwordNote, '请输入密码', ''); firstInvalid = firstInvalid || password; }
        if (firstInvalid) { firstInvalid.focus(); return; }
        username.value = trimmedUsername;
        setLoading(true);
        try {
          const response = await fetch('/login', {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
            credentials: 'same-origin',
            body: new URLSearchParams(new FormData(form))
          });
          const data = await response.json();
          if (!response.ok || !data.success) {
            status.textContent = data.msg || '登录失败，请重试';
            if (data.code === 'INVALID_CREDENTIALS') { password.value = ''; password.focus(); }
            return;
          }
          navigating = true;
          window.location.assign(data.redirect || '/');
        } catch (error) {
          status.textContent = '网络连接失败，请检查网络后重试。';
        } finally {
          if (!navigating) setLoading(false);
        }
      });
    })();
  </script>
</body>
</html>
