<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#ffffff">
  <title>ClawMaster / 我的溯源 - <%= brand %></title>
  <link rel="icon" href="/icons/pangolin-photo.png?v=20260905">
  <link rel="stylesheet" href="/css/style.css?v=20260901c">
  <style nonce="<%= cspNonce %>">
    .member-hero { padding: 32px; border: 1px solid #dfe3e8; border-radius: 16px; background: #fff; }
    .member-hero h1 { margin: 8px 0 10px; font-size: 30px; line-height: 1.35; }
    .trace-form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; margin-top: 24px; }
    .trace-form input { width: 100%; min-height: 48px; padding: 11px 14px; border: 1px solid #dfe3e8; border-radius: 10px; font-size: 15px; }
    .trace-form button { min-height: 48px; padding: 0 22px; }
    .member-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 16px; }
    .member-card { display: block; min-height: 150px; padding: 22px; border: 1px solid #dfe3e8; border-radius: 14px; background: #fff; color: #1f1f1f; text-decoration: none; }
    .member-card:hover { border-color: #1f1f1f; }
    .member-card .ui-icon { width: 22px; height: 22px; margin-bottom: 28px; }
    .member-card strong { display: block; margin-bottom: 6px; font-size: 16px; }
    @media (max-width: 720px) {
      .member-hero { padding: 24px 20px; }
      .member-hero h1 { font-size: 24px; }
      .trace-form { grid-template-columns: 1fr; }
      .member-grid { grid-template-columns: 1fr; }
      .member-card { min-height: auto; }
      .member-card .ui-icon { margin-bottom: 16px; }
    }
  </style>
  <link rel="stylesheet" href="/css/clawmaster.css?v=20260903a">
</head>
<body>
  <%- include('partials/nav', { active: 'member' }) %>

  <main class="container">
    <section class="member-hero">
      <h1><%= user.display_name || user.username %>，欢迎回来</h1>
      <form id="memberTraceForm" class="trace-form">
        <label for="memberTraceCode" class="sr-only">商品溯源码</label>
        <input id="memberTraceCode" type="text" autocomplete="off" placeholder="请输入商品溯源码" aria-label="商品溯源码">
        <button type="submit" class="btn btn-primary"><%- icon('search') %> 查询溯源</button>
      </form>
    </section>

    <section class="member-grid" aria-label="快捷入口">
      <a class="member-card" href="/v">
        <%- icon('camera') %>
        <strong>扫码验证</strong>
      </a>
      <a class="member-card" href="/profile">
        <%- icon('user') %>
        <strong>个人设置</strong>
      </a>
      <a class="member-card" href="/v">
        <%- icon('check') %>
        <strong>验证说明</strong>
      </a>
    </section>
  </main>

  <script nonce="<%= cspNonce %>">
    document.getElementById('memberTraceForm').addEventListener('submit', event => {
      event.preventDefault();
      const code = document.getElementById('memberTraceCode').value.trim();
      if (code) location.href = '/v/' + encodeURIComponent(code);
      else document.getElementById('memberTraceCode').focus();
    });
  </script>
</body>
</html>
