<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('partials/boot-head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>品牌营销 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/boot-loader') %>
  <%- include('partials/nav', { active: 'settings' }) %>

  <main class="container settings-page">
    <header class="page-heading settings-heading">
      <h1>品牌营销</h1>
      <div class="settings-heading-metric"><strong><%= campaigns.filter(c => c.enabled).length %></strong><span>个活动进行中</span></div>
    </header>
    <p class="section-help">品牌资料用于消费者扫码页；素材上传后点击“保存品牌资料”生效。活动创建后可随时停用。</p>

    <section class="data-display-module marketing-records" aria-labelledby="prizeRecordsTitle">
      <div class="marketing-section-head">
        <h2 id="prizeRecordsTitle">中奖记录</h2>
        <span class="record-limit">最近 50 条</span>
      </div>
      <div class="table-wrap"><table class="table marketing-table">
        <thead><tr><th>溯源码</th><th>活动</th><th>奖品</th><th>金额 / 内容</th><th>扫码区域</th><th>中奖时间</th></tr></thead>
        <tbody>
          <% if (prizes.length === 0) { %><tr><td colspan="6" class="empty-list-state">暂无中奖记录</td></tr><% } %>
          <% prizes.forEach(p => { %>
          <tr>
            <td class="mono-text"><%= p.item_code %></td>
            <td class="font-semibold"><%= p.campaign_name || '-' %></td>
            <td><%= p.prize_type === 'red_packet' ? '红包' : p.prize_type === 'coupon' ? '优惠券' : p.prize_type === 'goods' ? '实物' : '谢谢参与' %></td>
            <td><%= p.prize_name || '-' %><%= p.prize_value ? ' · ' + p.prize_value + ' 元' : '' %></td>
            <td class="meta-cell"><%= p.scan_location || '-' %></td>
            <td class="meta-cell"><%= p.created_at %></td>
          </tr>
          <% }); %>
        </tbody>
      </table></div>
    </section>

    <section class="marketing-brand-studio" aria-labelledby="brandStudioTitle">
      <div class="marketing-section-head">
        <h2 id="brandStudioTitle">品牌资料</h2>
        <div class="marketing-head-actions">
          <button class="btn btn-outline" id="previewH5Btn" type="button">预览扫码页</button>
          <button class="btn btn-primary" id="saveSettingsBtn" type="button">保存品牌资料</button>
        </div>
      </div>
      <div class="marketing-brand-grid">
        <div class="marketing-form-fields">
          <div class="form-group marketing-grid-wide"><label for="brandName">品牌名称</label><input type="text" id="brandName" class="form-control" value="<%= settings.brand_name || '' %>" placeholder="输入品牌名称"></div>
          <div class="form-group"><label for="logoText">文字标识</label><input type="text" id="logoText" class="form-control" value="<%= settings.logo_text || '' %>" placeholder="公司简称或 Emoji"></div>
          <div class="form-group"><label for="brandSubtitle">品牌副标题</label><input type="text" id="brandSubtitle" class="form-control" value="<%= settings.brand_subtitle || '' %>" placeholder="一句品牌主张"></div>
          <div class="form-group marketing-grid-wide"><label for="welcomeMsg">欢迎语</label><input type="text" id="welcomeMsg" class="form-control" value="<%= settings.welcome_msg || '' %>" placeholder="正品验证 · 一扫溯源"></div>
          <div class="form-group"><label for="contactPhone">客服电话</label><input type="text" id="contactPhone" class="form-control" value="<%= settings.contact_phone || '' %>" placeholder="选填"></div>
          <label class="scan-count-toggle"><input type="checkbox" id="showScanCount"> <span>显示累计扫码次数</span></label>
        </div>
        <aside class="brand-visual-panel">
          <div class="brand-logo-editor">
            <div class="brand-logo-orb"><img id="logoPreview" src="<%= settings.logo_image || '' %>" alt="品牌 Logo 预览" class="settings-logo-preview <%= settings.logo_image ? '' : 'is-hidden' %>"><span class="brand-logo-placeholder"><%= (settings.logo_text || '品').slice(0,1) %></span></div>
            <div><strong>品牌 Logo</strong><div class="marketing-inline-actions"><input type="file" id="logoFile" accept="image/jpeg,image/png,image/gif,image/webp" class="visually-hidden"><button class="btn btn-outline btn-sm" id="chooseLogoBtn" type="button">上传图片</button><button class="btn btn-outline btn-sm danger-action <%= settings.logo_image ? '' : 'is-hidden' %>" type="button" id="logoRemoveBtn">移除</button></div></div>
          </div>
          <% const themeValue = settings.theme_color && settings.theme_color.toLowerCase() !== '#1a73e8' ? settings.theme_color : '#0f7557'; %>
          <div class="theme-editor"><label for="themeColor">主题色</label><div class="theme-palette"><input type="color" id="themeColor" value="<%= themeValue %>" aria-label="自定义主题色"><button type="button" class="theme-swatch is-selected" data-theme-color="#0f7557" aria-label="森林绿"></button><button type="button" class="theme-swatch theme-gold" data-theme-color="#d39a32" aria-label="暖金"></button><button type="button" class="theme-swatch theme-coral" data-theme-color="#d96754" aria-label="珊瑚橙"></button><button type="button" class="theme-swatch theme-jade" data-theme-color="#2aa77a" aria-label="鲜翠绿"></button></div></div>
        </aside>
      </div>
    </section>

    <section class="marketing-media-section" aria-labelledby="mediaTitle">
      <div class="marketing-section-head"><h2 id="mediaTitle">图片与视频</h2></div>
      <div class="marketing-media-grid">
        <article class="media-upload-panel media-image-panel">
          <div><strong>产品图片</strong><span>最多 6 张</span></div>
          <input type="file" id="imgFiles" accept="image/jpeg,image/png,image/gif,image/webp" multiple class="visually-hidden">
          <button class="media-upload-action" id="chooseImagesBtn" type="button">＋ 添加图片</button>
          <span id="imgUploading" class="upload-status"></span>
          <div id="imgList" class="marketing-image-list"></div>
        </article>
        <article class="media-upload-panel media-video-panel">
          <div><strong>宣传视频</strong><span>扫码页展示</span></div>
          <input type="file" id="videoFile" accept="video/*" class="visually-hidden">
          <button class="media-upload-action" id="chooseVideoBtn" type="button">＋ 添加视频</button>
          <span id="videoUploading" class="upload-status"></span>
          <div id="videoInfo" class="marketing-video-info"></div>
        </article>
      </div>
    </section>

    <section class="marketing-campaign-studio" aria-labelledby="campaignTitleHeading">
      <div class="marketing-section-head"><h2 id="campaignTitleHeading">扫码活动</h2><button class="btn btn-coral" id="createCampaignBtn" type="button">创建活动</button></div>
      <div class="campaign-form-grid">
        <div class="form-group campaign-name"><label for="cName">活动名称</label><input type="text" id="cName" class="form-control" placeholder="输入活动名称"></div>
        <div class="form-group campaign-dates"><label>有效期</label><div class="date-range"><input type="date" id="cStart" class="form-control"><span>至</span><input type="date" id="cEnd" class="form-control"></div></div>
        <div class="form-group"><label for="cRate">中奖率</label><div class="input-suffix"><input type="number" id="cRate" class="form-control" value="30" min="0" max="100"><span>%</span></div></div>
        <div class="form-group"><label for="cType">奖品类型</label><select id="cType" class="form-control"><option value="red_packet">现金红包</option><option value="coupon">优惠券</option><option value="goods">实物奖品</option><option value="thanks">谢谢参与</option></select></div>
        <div class="form-group"><label for="cPrizeName">奖品名称</label><input type="text" id="cPrizeName" class="form-control" placeholder="如：满 100 减 20 券"></div>
        <div class="form-group" id="amountRow"><label>金额区间</label><div class="date-range"><input type="number" id="cMin" class="form-control" placeholder="最低" value="1"><span>至</span><input type="number" id="cMax" class="form-control" placeholder="最高" value="5"></div></div>
      </div>
      <div class="table-wrap campaign-table-wrap"><table class="table marketing-table">
        <thead><tr><th>活动名称</th><th>奖品</th><th>中奖率</th><th>有效期</th><th>状态</th><th>操作</th></tr></thead>
        <tbody>
          <% if (campaigns.length === 0) { %><tr><td colspan="6" class="empty-list-state">还没有创建活动</td></tr><% } %>
          <% campaigns.forEach(c => { %><tr><td class="font-semibold"><%= c.name %></td><td><%= c.prize_type === 'red_packet' ? '红包' : c.prize_type === 'coupon' ? '优惠券' : c.prize_type === 'goods' ? '实物' : '谢谢参与' %><%= c.prize_name ? ' · ' + c.prize_name : '' %><% if (c.prize_type === 'red_packet' || c.prize_type === 'coupon') { %> · <%= c.prize_min %>–<%= c.prize_max %> 元<% } %></td><td><strong class="campaign-rate"><%= c.win_rate %>%</strong></td><td class="meta-cell"><%= c.start_date %> — <%= c.end_date %></td><td><span class="tag <%= c.enabled ? 'tag-green' : 'tag-gray' %>"><%= c.enabled ? '进行中' : '已停用' %></span></td><td class="no-wrap"><button class="btn btn-outline btn-sm campaign-toggle-btn" type="button" data-campaign-id="<%= c.id %>"><%= c.enabled ? '停用' : '启用' %></button><button class="btn btn-outline btn-sm danger-action campaign-delete-btn" type="button" data-campaign-id="<%= c.id %>">删除</button></td></tr><% }); %>
        </tbody>
      </table></div>
    </section>

    <section class="backup-utility" aria-labelledby="backupTitle">
      <h2 id="backupTitle">数据备份</h2>
      <div class="backup-actions"><a class="btn btn-primary" href="/api/backup/download">立即备份并下载</a><button class="btn btn-outline" id="loadBackupsBtn" type="button">历史备份</button></div>
      <div id="backupList" class="backup-list"></div>
    </section>
  </main>

  <script nonce="<%= cspNonce %>">
    // ---- 历史备份列表 ----
    async function loadBackups() {
      const res = await fetch('/api/backups');
      const d = await res.json();
      const box = document.getElementById('backupList');
      if (!d.success || d.backups.length === 0) {
        box.innerHTML = '<p class="backup-empty">暂无历史备份</p>';
        return;
      }
      box.innerHTML = '<table class="table"><thead><tr><th>备份文件</th><th>大小</th><th>时间</th><th>操作</th></tr></thead><tbody>' +
        d.backups.map(b => `<tr>
          <td class="mono-text">${b.name}</td>
          <td>${(b.size / 1024).toFixed(1)} KB</td>
          <td class="meta-cell">${b.created_at}</td>
          <td><a class="btn btn-outline btn-sm" href="/api/backups/download/${encodeURIComponent(b.name)}">下载</a></td>
        </tr>`).join('') + '</tbody></table>';
    }

    // ---- 品牌素材状态 ----
    let imgArr = (('<%= (settings.product_images || '').replace(/'/g, "\\'") %>').split(/\r?\n/).map(s => s.trim()).filter(Boolean));
    let videoUrl = '<%= (settings.promo_video || '').replace(/'/g, "\\'") %>';
    let logoImage = '<%= (settings.logo_image || '').replace(/'/g, "\\'") %>';

    async function uploadLogo() {
      const f = document.getElementById('logoFile').files[0];
      if (!f) return;
      const fd = new FormData(); fd.append('files', f);
      try {
        const res = await fetch('/api/upload/images', { method: 'POST', body: fd });
        const d = await res.json();
        if (!d.success) return toast(d.msg || '上传失败', 'error');
        logoImage = d.urls[0];
        renderLogo();
        toast('上传成功，记得点击"保存品牌设置"', 'success');
      } catch (e) {
        toast('上传失败，请重试', 'error');
      }
    }
    function removeLogo() { logoImage = ''; renderLogo(); }
    function renderLogo() {
      const img = document.getElementById('logoPreview');
      img.src = logoImage;
      img.classList.toggle('is-hidden', !logoImage);
      document.getElementById('logoRemoveBtn').classList.toggle('is-hidden', !logoImage);
    }

    function renderImgs() {
      const box = document.getElementById('imgList');
      box.replaceChildren();
      if (!imgArr.length) {
        const empty = document.createElement('span');
        empty.className = 'media-empty';
        empty.textContent = '暂无图片';
        box.appendChild(empty);
        return;
      }
      imgArr.forEach((url, index) => {
        const item = document.createElement('figure');
        item.className = 'marketing-media-thumb';
        const image = document.createElement('img');
        image.src = url;
        image.alt = index === 0 ? '品牌封面' : `品牌图片 ${index + 1}`;
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'marketing-media-remove';
        remove.dataset.removeImage = String(index);
        remove.setAttribute('aria-label', '删除图片');
        remove.textContent = '×';
        item.append(image, remove);
        if (index === 0) {
          const cover = document.createElement('span');
          cover.className = 'marketing-cover-label';
          cover.textContent = '封面';
          item.appendChild(cover);
        }
        box.appendChild(item);
      });
    }
    function removeImg(i) { imgArr.splice(i, 1); renderImgs(); }
    function removeVideo() { videoUrl = ''; renderVideo(); }

    function renderVideo() {
      const el = document.getElementById('videoInfo');
      el.replaceChildren();
      if (!videoUrl) {
        const empty = document.createElement('span');
        empty.className = 'media-empty';
        empty.textContent = '暂无视频';
        el.appendChild(empty);
        return;
      }
      const row = document.createElement('div');
      row.className = 'marketing-video-row';
      const link = document.createElement('a');
      link.href = videoUrl;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = '查看已上传视频';
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'btn btn-outline btn-sm danger-action';
      remove.id = 'removeVideoBtn';
      remove.textContent = '删除';
      row.append(link, remove);
      el.appendChild(row);
    }

    async function uploadImages() {
      const input = document.getElementById('imgFiles');
      const files = [...input.files];
      input.value = '';
      if (!files.length) return;
      if (imgArr.length + files.length > 6) return toast('最多6张图片', 'error');
      const fd = new FormData();
      files.forEach(f => fd.append('files', f));
      document.getElementById('imgUploading').textContent = '上传中...';
      try {
        const res = await fetch('/api/upload/images', { method: 'POST', body: fd });
        const d = await res.json();
        document.getElementById('imgUploading').textContent = '';
        if (!d.success) return toast(d.msg || '上传失败', 'error');
        imgArr.push(...d.urls);
        renderImgs();
        toast('上传成功，记得点击"保存品牌设置"', 'success');
      } catch (e) {
        document.getElementById('imgUploading').textContent = '';
        toast('上传失败，请重试', 'error');
      }
    }

    async function uploadVideo() {
      const input = document.getElementById('videoFile');
      const file = input.files[0];
      input.value = '';
      if (!file) return;
      const fd = new FormData();
      fd.append('file', file);
      document.getElementById('videoUploading').textContent = '上传中（大视频请耐心等待）...';
      try {
        const res = await fetch('/api/upload/video', { method: 'POST', body: fd });
        const d = await res.json();
        document.getElementById('videoUploading').textContent = '';
        if (!d.success) return toast(d.msg || '上传失败', 'error');
        videoUrl = d.url;
        renderVideo();
        toast('上传成功，记得点击"保存品牌设置"', 'success');
      } catch (e) {
        document.getElementById('videoUploading').textContent = '';
        toast('上传失败，请重试', 'error');
      }
    }

    function toast(msg, type) {
      const t = document.createElement('div');
      t.className = 'toast ' + (type || 'success');
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3000);
    }

    function saveSettings() {
      const body = {
        brand_name: document.getElementById('brandName').value.trim(),
        brand_subtitle: document.getElementById('brandSubtitle').value.trim(),
        logo_text: document.getElementById('logoText').value.trim(),
        logo_image: logoImage,
        welcome_msg: document.getElementById('welcomeMsg').value.trim(),
        theme_color: document.getElementById('themeColor').value,
        contact_phone: document.getElementById('contactPhone').value.trim(),
        product_images: imgArr.join('\n'),
        promo_video: videoUrl,
        show_scan_count: document.getElementById('showScanCount').checked ? '1' : '0'
      };
      fetch('/api/settings', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify(body)
      }).then(r => r.json()).then(d => {
        if (d.success) toast(d.msg || '已保存', 'success');
        else toast(d.msg || '保存失败', 'error');
      });
    }

    function previewH5() {
      window.open('/v/demo', '_blank');
    }

    function togglePrizeInputs() {
      const type = document.getElementById('cType').value;
      document.getElementById('amountRow').hidden = !(type === 'red_packet' || type === 'coupon');
    }

    function createCampaign() {
      const body = {
        name: document.getElementById('cName').value.trim(),
        start_date: document.getElementById('cStart').value,
        end_date: document.getElementById('cEnd').value,
        win_rate: document.getElementById('cRate').value,
        prize_type: document.getElementById('cType').value,
        prize_name: document.getElementById('cPrizeName').value.trim(),
        prize_min: document.getElementById('cMin').value,
        prize_max: document.getElementById('cMax').value,
        enabled: 1
      };
      if (!body.name) return toast('请输入活动名称', 'error');
      fetch('/api/campaigns', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify(body)
      }).then(r => r.json()).then(d => {
        if (d.success) { toast(d.msg || '创建成功', 'success'); setTimeout(() => location.reload(), 600); }
        else toast(d.msg || '创建失败', 'error');
      });
    }

    function toggleCampaign(id) {
      fetch(`/api/campaigns/${id}/toggle`, { method: 'POST' })
        .then(r => r.json()).then(() => location.reload());
    }

    function deleteCampaign(id) {
      if (!confirm('确定删除该活动？')) return;
      fetch(`/api/campaigns/${id}`, { method: 'DELETE' })
        .then(r => r.json()).then(() => location.reload());
    }

    const themeInput = document.getElementById('themeColor');
    document.querySelectorAll('.theme-swatch').forEach(swatch => {
      swatch.addEventListener('click', () => {
        themeInput.value = swatch.dataset.themeColor;
        document.querySelectorAll('.theme-swatch').forEach(item => item.classList.toggle('is-selected', item === swatch));
      });
    });
    themeInput.addEventListener('input', () => {
      document.querySelectorAll('.theme-swatch').forEach(item => item.classList.toggle('is-selected', item.dataset.themeColor.toLowerCase() === themeInput.value.toLowerCase()));
    });

    document.getElementById('previewH5Btn').addEventListener('click', previewH5);
    document.getElementById('saveSettingsBtn').addEventListener('click', saveSettings);
    document.getElementById('chooseLogoBtn').addEventListener('click', () => document.getElementById('logoFile').click());
    document.getElementById('logoRemoveBtn').addEventListener('click', removeLogo);
    document.getElementById('logoFile').addEventListener('change', uploadLogo);
    document.getElementById('chooseImagesBtn').addEventListener('click', () => document.getElementById('imgFiles').click());
    document.getElementById('imgFiles').addEventListener('change', uploadImages);
    document.getElementById('chooseVideoBtn').addEventListener('click', () => document.getElementById('videoFile').click());
    document.getElementById('videoFile').addEventListener('change', uploadVideo);
    document.getElementById('createCampaignBtn').addEventListener('click', createCampaign);
    document.getElementById('loadBackupsBtn').addEventListener('click', loadBackups);
    document.getElementById('cType').addEventListener('change', togglePrizeInputs);
    document.getElementById('imgList').addEventListener('click', event => {
      const button = event.target.closest('[data-remove-image]');
      if (button) removeImg(Number(button.dataset.removeImage));
    });
    document.getElementById('videoInfo').addEventListener('click', event => {
      if (event.target.closest('#removeVideoBtn')) removeVideo();
    });
    document.querySelectorAll('.campaign-toggle-btn').forEach(button => button.addEventListener('click', () => toggleCampaign(Number(button.dataset.campaignId))));
    document.querySelectorAll('.campaign-delete-btn').forEach(button => button.addEventListener('click', () => deleteCampaign(Number(button.dataset.campaignId))));

    // 初始化素材区
    document.getElementById('showScanCount').checked = '<%= settings.show_scan_count === undefined || settings.show_scan_count === null ? '1' : settings.show_scan_count %>' !== '0';
    togglePrizeInputs();
    renderImgs();
    renderVideo();
  </script>
</body>
</html>
