<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#e3f6ef">
  <title>商品溯源码查询 · 穿山甲溯源大师</title>
  <link rel="icon" href="/icons/pangolin-photo.png?v=20260905">
  <link rel="preload" as="image" href="/images/trace-background.webp?v=20260917">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/register-glass.css?v=20260917fit2">
  <link rel="stylesheet" href="/css/verify-glass.css?v=20260917">
</head>
<body class="verify-page">
  <main class="query-page">
    <section class="register-shell query-shell" aria-labelledby="queryTitle">
      <h1 id="queryTitle" class="query-heading"><a href="#codeInput">商品溯源码查询</a></h1>
      <form id="verifyForm" novalidate>
        <div id="queryMessage" class="msg error" role="status" hidden>请输入溯源码</div>
        <div class="form-grid">
          <div class="form-group">
            <label for="codeInput">溯源码</label>
            <div class="query-code-row">
              <div class="glass-field"><input type="text" id="codeInput" name="code" placeholder="输入溯源码" value="<%= code %>" autocomplete="off" autocapitalize="characters" spellcheck="false" required></div>
              <button id="scanButton" type="button" class="scan-button" title="摄像头扫码" aria-label="摄像头扫码"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3l2-3h6l2 3h3v13H4Z"/><circle cx="12" cy="13" r="4"/></svg></button>
            </div>
          </div>
          <div class="form-group">
            <label for="locationInput" title="选填，留空自动按IP定位，用于串货检测">当前位置（选填）</label>
            <div class="glass-field"><input type="text" id="locationInput" name="location" placeholder="如：广东省深圳市" autocomplete="address-level2"></div>
          </div>
        </div>
        <button id="verifyButton" type="submit" class="glass-button btn-register">立即验证</button>
      </form>
      <div class="back"><a href="/login"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg><span>返回登录</span></a></div>
      <% if (settings.contact_phone) { %><a class="query-contact" href="tel:<%= settings.contact_phone %>">客服热线：<%= settings.contact_phone %></a><% } %>
    </section>
    <% const imgList = (settings.product_images || '').split(/\r?\n/).map(s => s.trim()).filter(Boolean); %>
    <% if (imgList.length || settings.promo_video) { %>
    <section class="query-media" aria-label="商品介绍">
      <% if (imgList.length) { %>
      <div class="carousel" id="carousel">
        <% imgList.forEach((u, idx) => { %><img src="<%= u %>" alt="产品图 <%= idx + 1 %>" <%= idx ? 'hidden' : '' %>><% }); %>
        <% if (imgList.length > 1) { %><button type="button" class="car-btn car-prev" data-carousel-step="-1" aria-label="上一张商品图">‹</button><button type="button" class="car-btn car-next" data-carousel-step="1" aria-label="下一张商品图">›</button><% } %>
      </div>
      <% if (imgList.length > 1) { %><div class="car-dots" id="carDots"><% imgList.forEach((u, idx) => { %><button type="button" class="<%= idx === 0 ? 'active' : '' %>" data-carousel-index="<%= idx %>" aria-label="第 <%= idx + 1 %> 张商品图"></button><% }); %></div><% } %>
      <% } %>
      <% if (settings.promo_video) { %><video src="<%= settings.promo_video %>" controls playsinline preload="metadata"></video><% } %>
    </section>
    <% } %>
  </main>
  <dialog id="traceResult" class="trace-dialog" aria-labelledby="resultTitle">
    <div class="trace-dialog-header"><h2 id="resultTitle">溯源结果</h2><button id="closeResult" type="button" aria-label="关闭溯源结果"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <div id="resultArea" role="status" aria-live="polite"></div>
  </dialog>
  <script src="/js/html5-qrcode.min.js"></script>
  <script src="/js/scanner.js"></script>
  <script nonce="<%= cspNonce %>">
    // 摄像头扫码：识别后自动填入并验证
    function scanCode() {
      openScanner({
        title: '扫描产品上的溯源二维码',
        onScanned: (code) => {
          document.getElementById('codeInput').value = code;
          doVerify(code, document.getElementById('locationInput').value.trim());
        }
      });
    }

    // 图片轮播
    let carIdx = 0;
    function carRender() {
      const imgs = document.querySelectorAll('#carousel img');
      const dots = document.querySelectorAll('#carDots button');
      imgs.forEach((im, i) => { im.hidden = i !== carIdx; });
      dots.forEach((d, i) => d.className = i === carIdx ? 'active' : '');
    }
    function carMove(step) {
      const imgs = document.querySelectorAll('#carousel img');
      if (!imgs.length) return;
      carIdx = (carIdx + step + imgs.length) % imgs.length;
      carRender();
    }
    function carGo(i) { carIdx = i; carRender(); }

    function verify() {
      const code = document.getElementById('codeInput').value.trim();
      const location = document.getElementById('locationInput').value.trim();
      if (!code) { document.getElementById('queryMessage').hidden = false; document.getElementById('codeInput').focus(); return; }
      document.getElementById('queryMessage').hidden = true;
      doVerify(code, location);
    }

    const supportPhone = <%- JSON.stringify(settings.contact_phone || '').replace(/</g, '\u003c') %>;
    const brandName = <%- JSON.stringify(settings.brand_name || '本品牌').replace(/</g, '\u003c') %>;
    const resultDialog = document.getElementById('traceResult');
    const verifyButton = document.getElementById('verifyButton');
    const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    function escapeViewData(value) {
      if (typeof value === 'string') return escapeHtml(value);
      if (Array.isArray(value)) return value.map(escapeViewData);
      if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).map(([key,item]) => [key,escapeViewData(item)]));
      return value;
    }
    document.getElementById('verifyForm').addEventListener('submit', event => { event.preventDefault(); verify(); });
    document.getElementById('scanButton').addEventListener('click', scanCode);
    document.getElementById('codeInput').addEventListener('input', () => { document.getElementById('queryMessage').hidden = true; });
    document.getElementById('closeResult').addEventListener('click', () => resultDialog.close());
    resultDialog.addEventListener('close', () => verifyButton.focus());
    document.querySelector('.query-heading a').addEventListener('click', event => { event.preventDefault(); document.getElementById('codeInput').focus(); });
    document.querySelectorAll('[data-carousel-step]').forEach(button => button.addEventListener('click', () => carMove(Number(button.dataset.carouselStep))));
    document.querySelectorAll('[data-carousel-index]').forEach(button => button.addEventListener('click', () => carGo(Number(button.dataset.carouselIndex))));

    async function doVerify(code, location) {
      if (verifyButton.disabled) return;
      verifyButton.disabled = true;
      verifyButton.setAttribute('aria-busy', 'true');
      if (!resultDialog.open) resultDialog.showModal();
      try {
      const area = document.getElementById('resultArea');
      area.innerHTML = '<div class="h5-card"><div class="loading">⏳ 正在验证...</div></div>';

      let url = `/api/verify/${encodeURIComponent(code)}`;
      const q = [];
      if (location) q.push('location=' + encodeURIComponent(location));
      if (q.length) url += '?' + q.join('&');
      const res = await fetch(url);
      const data = escapeViewData(await res.json());

      if (!data.success) {
        area.innerHTML = `
          <div class="h5-card">
            <div class="verify-status err">
              <div class="icon">⚠️</div>
              <div class="text">${data.msg}</div>
            </div>
            <div class="info-row"><span class="label">查询码</span><span class="value code-text">${escapeHtml(code)}</span></div>
            <div class="info-row"><span class="label">查询时间</span><span class="value">${new Date().toLocaleString('zh-CN')}</span></div>
          </div>
        `;
        return;
      }

      let statusIcon, statusClass, statusText;
      if (data.is_diversion > 0) {
        statusIcon = '⚠️'; statusClass = 'warn';
        statusText = data.is_diversion >= 2 ? '疑似串货（跨省）' : '疑似串货';
      } else if (data.type === 'item') {
        statusIcon = '✅'; statusClass = 'ok'; statusText = '正品验证通过';
      } else {
        statusIcon = '📦'; statusClass = 'ok'; statusText = '箱码验证通过';
      }

      let html = `
        <div class="h5-card">
          <div class="verify-status ${statusClass}">
            <div class="icon">${statusIcon}</div>
            <div class="text">${statusText}</div>
          </div>
      `;

      // 多次扫码提醒
      const scanCount = data.scan_count || 1;
      if (scanCount === 1) {
        html += `<div class="info-row"><span class="label">查询次数</span><span class="value">首次查询</span></div>`;
      } else if (scanCount === 2) {
        html += `<div class="scan-times">🔎 该码此前已被查询过 1 次，请确认产品来源渠道。</div>`;
      } else {
        html += `<div class="scan-times warn">⚠️ 该码已被查询 ${scanCount} 次，谨防假冒！如非本人操作请立即联系厂家核实。</div>`;
      }
      if (scanCount > 1 && data.first_scanned_at) {
        html += `<div class="info-row"><span class="label">首次查询</span><span class="value small-text">${data.first_scanned_at} ${data.first_scan_location || ''}</span></div>`;
      }

      // 串货警示
      if (data.is_diversion > 0) {
        const scanLoc = escapeHtml(location) || data.resolved_location || '未知';
        const levelText = data.is_diversion >= 2 ? '该产品跨省流通，疑似恶意串货' : '该产品与指定销售区域不符，存在串货嫌疑';
        html += `
          <div class="alert-box danger">
            ⚠️ ${levelText}。指定区域「${data.region || '未知'}」，当前扫码「${scanLoc}」。已记录并通知厂家。
          </div>
        `;
      }

      html += `
          <div class="info-row"><span class="label">产品名称</span><span class="value">${data.product_name || '（待装箱绑定产品）'}</span></div>
      `;

      if (data.product_spec) {
        html += `<div class="info-row"><span class="label">产品规格</span><span class="value">${data.product_spec}</span></div>`;
      }
      html += `<div class="info-row"><span class="label">批次号</span><span class="value">${data.batch_no || '-'}</span></div>`;

      if (data.type === 'item') {
        html += `<div class="info-row"><span class="label">所属箱码</span><span class="value code-text">${data.box_code || '-'}</span></div>`;
      }

      html += `
          <div class="info-row"><span class="label">发货状态</span><span class="value">${data.status_text}</span></div>
          <div class="info-row"><span class="label">代理区域</span><span class="value">${data.region || '未发货'}</span></div>
      `;

      if (data.resolved_location) {
        html += `<div class="info-row"><span class="label">扫码位置</span><span class="value">${data.resolved_location}</span></div>`;
      }

      if (data.type === 'box' && data.items) {
        html += `
          <div class="code-list-title">箱内产品码（${data.items.length}个）</div>
          <div class="code-list">
            ${data.items.map(i => `<div class="code-list-row">${i.item_code} ${i.status==='scanned' ? '<span class="tag tag-green" >已验</span>' : '<span class="tag tag-gray" >未验</span>'}</div>`).join('')}
          </div>
        `;
      }

      html += `
          <div class="info-row"><span class="label">生产时间</span><span class="value">${data.created_at || '-'}</span></div>
      `;
      if (data.shipped_at) {
        html += `<div class="info-row"><span class="label">发货时间</span><span class="value">${data.shipped_at}</span></div>`;
      }
      html += `<div class="info-row"><span class="label">验证时间</span><span class="value">${new Date().toLocaleString('zh-CN')}</span></div>`;

      <% if (settings.contact_phone) { %>
      html += `<div class="info-row"><span class="label">客服电话</span><span class="value"><a href="tel:${escapeHtml(supportPhone.replace(/[^\d+]/g, ''))}" class="contact-link">${escapeHtml(supportPhone)}</a></span></div>`;
      <% } %>

      html += `</div>`;

      // 抽奖结果
      if (data.prize) {
        const p = data.prize;
        let prizeHtml = '';
        if (p.prize_type === 'red_packet') {
          prizeHtml = `
            <div class="prize-card">
              <div class="p-icon">💰</div>
              <div class="p-title">恭喜中奖！</div>
              <div class="p-money">¥ ${p.prize_value}</div>
              <div class="p-sub">${p.prize_name || '现金红包'} · 联系客服领取</div>
            </div>`;
        } else if (p.prize_type === 'coupon') {
          prizeHtml = `
            <div class="prize-card">
              <div class="p-icon">🎟️</div>
              <div class="p-title">恭喜获得优惠券</div>
              <div class="p-money">¥ ${p.prize_value || p.prize_name}</div>
              <div class="p-sub">${p.prize_name || '优惠券'} · 下单时使用</div>
            </div>`;
        } else if (p.prize_type === 'goods') {
          prizeHtml = `
            <div class="prize-card">
              <div class="p-icon">🎁</div>
              <div class="p-title">恭喜获得实物奖品</div>
              <div class="p-sub">${p.prize_name || '神秘好礼'} · 联系客服领取</div>
            </div>`;
        } else {
          prizeHtml = `
            <div class="prize-card thanks">
              <div class="p-icon">👋</div>
              <div class="p-title">谢谢参与</div>
              <div class="p-sub">感谢支持${escapeHtml(brandName)}，下次好运！</div>
            </div>`;
        }
        area.innerHTML = prizeHtml + html;
      } else {
        area.innerHTML = html;
      }
      } catch {
        document.getElementById('resultArea').textContent = '查询暂时不可用，请稍后重试';
      } finally {
        verifyButton.disabled = false;
        verifyButton.removeAttribute('aria-busy');
      }
    }

    // 如果URL中带有码，自动验证
    const code = <%- JSON.stringify(code).replace(/</g, '\u003c') %>;
    if (code && code !== ':code' && code !== 'demo') {
      doVerify(code, '');
    }
  </script>
</body>
</html>
